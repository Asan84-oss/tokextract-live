# ── TokExtract · RapidAPI credentials ─────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
# Vite only ships VITE_-prefixed variables to the browser bundle;
# the client also accepts unprefixed names if your dashboard injects
# them that way (see src/lib/api.ts).

VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=tiktok-download-without-watermark.p.rapidapi.com
