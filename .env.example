# ── TokExtract · RapidAPI credentials (template) ──────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.
# Vite ships VITE_-prefixed variables into the browser bundle at
# build time (import.meta.env). The client also accepts unprefixed
# names if your dashboard injects them that way (see src/lib/api.ts).
#
# Current live provider: tiktok-video-no-watermark2.p.rapidapi.com
# Route: GET /?url=<tiktok-link>&hd=1  ·  headers: X-RapidAPI-Key,
# X-RapidAPI-Host, Content-Type: application/json

VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=tiktok-video-no-watermark2.p.rapidapi.com
